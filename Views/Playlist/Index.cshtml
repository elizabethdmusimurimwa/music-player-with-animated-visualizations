
@model IEnumerable<GrooveyTunes.Models.Playlist>

@{
    ViewBag.Title = "My Playlists";
}

<div class="gt-page">

    <h2 class="gt-page-title">Playlists</h2>
    <p class="gt-page-subtitle">Your collections, ready to play.</p>

    <div class="gt-card-grid">

        @foreach (var playlist in Model)
        {
            <div class="gt-tile">

                <a href="@Url.Action("Details", "Playlist", new { id = playlist.PlaylistId })"
                   style="text-decoration:none; color:inherit;">

                    <div class="gt-tile-text">
                        <span class="gt-tile-title">
                            @playlist.PlaylistName
                        </span>
                    </div>

                </a>

                <div style="margin-top:10px; text-align:right;">

                    @using (Html.BeginForm(
                        "Delete",
                        "Playlist",
                        new { id = playlist.PlaylistId },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                    <button type="submit"
                            title="Delete Playlist"
                            aria-label="Delete @playlist.PlaylistName"
                            style="width:42px;
               height:42px;
               padding:0;
               color:black;
               background:transparent;
               border:2px solid black;
               border-radius:50%;
               font-size:23px;
               display:inline-flex;
               align-items:center;
               justify-content:center;
               cursor:pointer;"
                            onclick="return confirm('Are you sure you want to delete this playlist? This action cannot be undone.');">

                        &#128465;

                    </button>
                    }

                </div>

            </div>
        }

    </div>

    <div style="margin-top:20px;">
        @Html.ActionLink(
                 "Create New Playlist",
                 "Create",
                 "Playlist",
                 null,
                 new { @class = "gt-btn gt-btn-primary" }
             )
    </div>

</div>
