
@model GrooveyTunes.Models.Playlist

@{
    ViewBag.Title = "Playlist Details";
}

<div class="gt-page">

    <h2 class="gt-page-title">@Model.PlaylistName</h2>

    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Url.Content(Model.ImagePath)"
             alt="@Model.PlaylistName"
             style="width:180px; height:180px; object-fit:cover; border-radius:10px;" />
    }

    <div class="gt-actions" style="margin:18px 0;">

        @Html.ActionLink(
                 "Add Songs",
                 "AddSong",
                 "Playlist",
                 new { id = Model.PlaylistId },
                 new
                 {
                     @class = "gt-btn gt-btn-primary",
                     style = "padding:6px 12px; font-size:13px;"
                 }
             )

        @Html.ActionLink(
                 "Back to Playlists",
                 "Index",
                 "Playlist",
                 null,
                 new
                 {
                     @class = "gt-btn gt-btn-ghost",
                     style = "padding:6px 12px; font-size:13px;"
                 }
             )

    </div>

    <hr />

    <h3>Songs in This Playlist</h3>

    @if (Model.PlaylistSongs != null && Model.PlaylistSongs.Any())
    {
        <div class="gt-card-grid">

            @foreach (var item in Model.PlaylistSongs)
            {
                var song = item.Song;

                var artistName = song.Artist != null
                    ? song.Artist.ArtistName
                    : "Unknown Artist";

                var audioUrl = string.IsNullOrEmpty(song.AudioPath)
                    ? ""
                    : Url.Content(song.AudioPath);

                <div class="gt-tile">

                    @if (!string.IsNullOrEmpty(song.ImagePath))
                    {
                        <img src="@Url.Content(song.ImagePath)"
                             alt="@song.Title"
                             style="width:100%; height:150px; object-fit:cover;" />
                    }

                    <div class="gt-tile-text">

                        <span class="gt-tile-title">
                            @song.Title
                        </span>

                        <p>@artistName</p>

                        <p>Album: @song.Album</p>

                        <div class="gt-actions">

                            <button type="button"
                                    class="play-btn play-song"
                                    data-title="@song.Title"
                                    data-artist="@artistName"
                                    data-audio="@audioUrl"
                                    title="Play Song"
                                    disabled="@(string.IsNullOrEmpty(audioUrl))">
                                @Icons.Draw("play")
                            </button>

                            @using (Html.BeginForm(
                                "RemoveSong",
                                "Playlist",
                                FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="playlistId"
                                       value="@Model.PlaylistId" />

                                <input type="hidden"
                                       name="songId"
                                       value="@song.SongId" />

                                <button type="submit"
                                        class="gt-btn gt-btn-ghost"
                                        style="padding:6px 10px; font-size:12px;"
                                        onclick="return confirm('Remove this song from the playlist?');">
                                    Remove
                                </button>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <p>This playlist has no songs yet. Click Add Songs to get started.</p>
    }

</div>
