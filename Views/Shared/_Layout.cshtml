
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - GroovyTunes</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/Site.css")" />

</head>

<body>

    <div class="app-container">

        <!-- Sidebar -->

        <aside class="sidebar">

            <h2 class="logo">♫ GroovyTunes</h2>

            <nav>
                <a href="@Url.Action("Index", "Home")">
                    🏠 Home
                </a>

                <a href="@Url.Action("Index", "Playlist")">
                    ♫ Playlists
                </a>

                <a href="@Url.Action("Index", "Artists")">
                    🎤 Artists
                </a>

                <a href="@Url.Action("Index", "Player")">
                    ▶ Player
                </a>
            </nav>

        </aside>

        <!-- Page content -->

        <main class="main-content">

            @RenderBody()

        </main>

    </div>

    <!-- Shared music player -->

    @Html.Partial("_MusicPlayer")

    <script src="@Url.Content("~/Scripts/GroovyTunes.js")"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
