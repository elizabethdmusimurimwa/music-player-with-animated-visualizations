@model IEnumerable<GrooveyTunes.Models.Artist>

@{
    ViewBag.Title = "Artists";
}

<div class="gt-page">
    <h2 class="gt-page-title">Artists</h2>
    <p class="gt-page-subtitle">Pick an artist and start listening.</p>

    <div class="gt-card-grid">
        @foreach (var artist in Model)
        {
            <a href="@Url.Action("Details", "Artists", new { id = artist.ArtistId })"
               class="gt-tile">
                @if (!string.IsNullOrEmpty(artist.ImagePath))
                {
                    <img src="@Url.Content(artist.ImagePath)"
                         alt="@artist.ArtistName"
                         class="gt-tile-img" />
                }
                <div class="gt-tile-text">
                    <span class="gt-tile-title">@artist.ArtistName</span>
                </div>
            </a>
        }
    </div>
</div>